# xport Docker Compose Configuration
#
# Generate keys with:
#   ./xport keygen -name keys/receiver
#   ./xport keygen -name keys/sender
#   ./xport keygen -name keys/monitor
#
# Copy the printed fingerprints into this file and rename to .env:

# SHA-256 fingerprint of the sender's certificate (required by receiver)
SENDER_FP=

# SHA-256 fingerprint of the receiver's certificate (required by sender)
RECEIVER_FP=

# SHA-256 fingerprint of the monitor's certificate (optional, for status endpoints)
MONITOR_FP=
